{
  "agents": [
    {
      "id": "scheduling",
      "name": "Production Scheduling",
      "description": "Optimizes production schedules and manages downtime",
      "icon": "Clock",
      "enabledFor": {
        "industries": ["manufacturing", "mixed"],
        "minSize": "small"
      }
    },
    {
      "id": "qa",
      "name": "Quality Assurance",
      "description": "Monitors quality standards and catches issues early",
      "icon": "CheckCircle",
      "enabledFor": {
        "industries": ["manufacturing", "services", "mixed"],
        "minSize": "small"
      }
    },
    {
      "id": "inventory",
      "name": "Inventory Management",
      "description": "Manages stock levels and supply optimization",
      "icon": "Package",
      "enabledFor": {
        "industries": ["manufacturing", "trading", "mixed"],
        "minSize": "small"
      }
    },
    {
      "id": "sales",
      "name": "Sales & Dispatch",
      "description": "Handles dispatch operations and customer deliveries",
      "icon": "Truck",
      "enabledFor": {
        "industries": ["manufacturing", "trading", "mixed"],
        "minSize": "small"
      }
    },
    {
      "id": "rd",
      "name": "R&D & Formulation",
      "description": "Supports product development and formulation decisions",
      "icon": "Beaker",
      "enabledFor": {
        "industries": ["manufacturing", "mixed"],
        "minSize": "small"
      }
    },
    {
      "id": "production",
      "name": "Production & Reporting",
      "description": "Manages production workflows and generates reports",
      "icon": "Factory",
      "enabledFor": {
        "industries": ["manufacturing", "services", "mixed"],
        "minSize": "small"
      }
    }
  ],
  "industryAgentMapping": {
    "manufacturing": ["scheduling", "qa", "inventory", "sales", "rd", "production"],
    "trading": ["inventory", "sales", "production"],
    "services": ["production", "scheduling", "qa"],
    "mixed": ["scheduling", "qa", "inventory", "sales", "rd", "production"]
  },
  "companySizes": {
    "small": {
      "departments": "1-2",
      "maxAgents": 2
    },
    "medium": {
      "departments": "3-4",
      "maxAgents": 4
    },
    "large": {
      "departments": "5-6",
      "maxAgents": 6
    },
    "enterprise": {
      "departments": "7+",
      "maxAgents": 6,
      "prioritySupport": true
    }
  },
  "painPointMapping": {
    "downtime": {
      "agent": "scheduling",
      "priority": 1
    },
    "quality": {
      "agent": "qa",
      "priority": 1
    },
    "inventory": {
      "agent": "inventory",
      "priority": 1
    },
    "dispatch": {
      "agent": "sales",
      "priority": 1
    },
    "rd": {
      "agent": "rd",
      "priority": 1
    },
    "reporting": {
      "agent": "production",
      "priority": 1
    }
  },
  "uxModes": [
    {
      "id": "chat",
      "label": "Chat interface",
      "description": "Type questions, get instant answers"
    },
    {
      "id": "file_upload",
      "label": "File upload",
      "description": "Upload files and get structured reports"
    },
    {
      "id": "alerts",
      "label": "Proactive alerts",
      "description": "Get notifications without asking"
    },
    {
      "id": "hybrid",
      "label": "Mix of all",
      "description": "Use all three modes together"
    }
  ],
  "dataReadinessDocuments": [
    {
      "key": "has_sops",
      "label": "SOPs and process manuals",
      "types": ["pdf", "word"],
      "enablesRag": true
    },
    {
      "key": "has_quality_docs",
      "label": "Quality standards and test reports",
      "types": ["pdf", "excel"],
      "enablesAgent": "qa"
    },
    {
      "key": "has_machine_docs",
      "label": "Machine or equipment manuals",
      "types": ["pdf", "word"],
      "enablesAgent": "scheduling"
    },
    {
      "key": "has_excel_data",
      "label": "Historical production/sales records",
      "types": ["excel"],
      "enablesIngestion": true
    },
    {
      "key": "low_readiness",
      "label": "We have most things in paper",
      "enablesShadowMode": true
    }
  ]
}
